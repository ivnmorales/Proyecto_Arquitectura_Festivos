    {
      "name": "7. CRUD Tipo",
      "description": "CRUD completo de la tabla Tipo. Crea un tipo temporal con nombre único, lo consulta, lo modifica y lo elimina, por lo que la base de datos queda como estaba. Los tipos 1, 2 y 3 no se pueden eliminar porque los usa la generación del calendario.",
      "item": [
        {
          "name": "Listar tipos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tipos/listar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tipos",
                "listar"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Incluye los tipos 1, 2 y 3\", () => pm.expect(t.map(x => x.id)).to.include.members([1, 2, 3]));",
                  "pm.test(\"Ordenados por Id\", () => t.forEach((x, i) => { if (i > 0) pm.expect(x.id > t[i - 1].id).to.be.true; }));",
                  "pm.test(\"Nombres sin espacios al final\", () => t.forEach(x => pm.expect(x.tipo).to.eql(x.tipo.trim())));"
                ]
              }
            }
          ]
        },
