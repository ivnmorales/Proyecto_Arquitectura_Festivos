          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const f = pm.response.json();",
                  "const fecha = n => (f.find(x => x.nombre === n) || {}).fecha;",
                  "pm.test(\"Fijo: Navidad 2026-12-25\", () => pm.expect(fecha(\"Navidad\")).to.eql(\"2026-12-25\"));",
                  "pm.test(\"Puente: Santos Reyes 2026-01-12\", () => pm.expect(fecha(\"Santos Reyes\")).to.eql(\"2026-01-12\"));",
                  "pm.test(\"Pascua: Viernes Santo 2026-04-03\", () => pm.expect(fecha(\"Viernes Santo\")).to.eql(\"2026-04-03\"));",
                  "pm.test(\"Pascua + puente: Corpus Christi 2026-06-08\", () => pm.expect(fecha(\"Corpus Christi\")).to.eql(\"2026-06-08\"));",
                  "pm.test(\"Ordenados por fecha\", () => pm.expect(f.map(x => x.fecha)).to.eql([...f.map(x => x.fecha)].sort()));"
                ]
              }
            }
          ]
